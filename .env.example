# Локальная разработка. На Render эти переменные задаются в панели сервиса (см. render.yaml).

# Токен бота от @BotFather. Для локального запуска — ОТДЕЛЬНЫЙ тестовый бот, не боевой с Render
BOT_TOKEN=123456:replace-me
# Публичный HTTPS-адрес, по которому открывается Mini App.
# Локально — туннель: cloudflared tunnel --url http://localhost:8000 (на Render подставится сам)
WEBAPP_URL=https://example.com
# polling — локально; webhook — на хостинге; off — без бота
BOT_MODE=polling
# Сколько секунд initData считается действительной
INIT_DATA_TTL_SECONDS=86400
