# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me
# Публичный HTTPS-адрес, по которому открывается Mini App.
# Для локальной разработки — туннель: cloudflared tunnel --url http://localhost:8000
WEBAPP_URL=https://example.com
# Сколько секунд initData считается действительной
INIT_DATA_TTL_SECONDS=86400
# Папка со статикой Mini App (относительно каталога запуска)
FRONTEND_DIR=frontend
# Запускать бота в этом процессе (polling). При нескольких воркерах — true ровно в одном
RUN_BOT=true
